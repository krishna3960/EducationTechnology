[node name="RichTextLabel" type="RichTextLabel" parent="CanvasLayer/MarginContainer/MainLayout/MiddleRow/EnergyPanel/MarginContainer/PanelVBox/MiddleRow" unique_id=1688867626]
custom_minimum_size = Vector2(0, 130)
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 0
theme_override_font_sizes/normal_font_size = 16
theme_override_font_sizes/bold_font_size = 17
theme_override_font_sizes/bold_italics_font_size = 17
theme_override_font_sizes/italics_font_size = 17
theme_override_font_sizes/mono_font_size = 17
text = "As CEO, your expansion contributes to the rapidly growing global energy demand of AI infrastructure, which currently accounts for 15–20% of data center electricity consumption worldwide. Overall, AI systems consume enough energy each year to power approximately two to three and a half times the number of Swiss family households."

